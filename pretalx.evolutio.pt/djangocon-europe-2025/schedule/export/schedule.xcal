            <pentabarf:title>Annual meeting of DSF Members at DjangoCon Europe</pentabarf:title>
            <pentabarf:subtitle></pentabarf:subtitle>
            <pentabarf:language>en</pentabarf:language>
            <pentabarf:language-code>en</pentabarf:language-code>
            <dtstart>20250424T080000</dtstart>
            <dtend>20250424T085000</dtend>
            <duration>005000</duration>
            <summary>Annual meeting of DSF Members at DjangoCon Europe</summary>
            <description></description>
            <class>PUBLIC</class>
            <status>CONFIRMED</status>
            <category>Other</category>
            <url>https://pretalx.evolutio.pt//djangocon-europe-2025/talk/GJDTBU/</url>
